# --- API (apps/api-fastapi) ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Optional override for outbound requests when fetching Google Sheets CSV
# HTTP_USER_AGENT=Mozilla/5.0 (compatible; MyApp/1.0)

# --- Web dev server (apps/web) — Vite reads these from the repository root ---
VITE_DEV_PORT=5173
# Used by Vite proxy to reach the API during local development
API_PORT=5000
VITE_BASE_PATH=/

# If the browser cannot use same-origin /api (e.g. static hosting separate from API), set the API origin:
# VITE_API_BASE_URL=https://your-api.example.com

# --- Database (@workspace/db) — only if you use Drizzle / PostgreSQL ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/sheet_insights
